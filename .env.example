# SMTP (required for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact form recipients
CONTACT_TO_EMAIL=support@etarath.ai
CONTACT_FROM_EMAIL=noreply@etarath.ai

# Calendly demo booking link (used in Banner "Book a Demo")
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/etarath/demo

# Backend API base URL (e.g. https://api.example.com/api)
NEXT_PUBLIC_BACKEND_URL=
